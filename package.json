{
  "name": "rayfin-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official documentation site for Rayfin — Microsoft's TypeScript backend-as-a-service, managed on Microsoft Fabric.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "build": "next build && npm run emit:agent",
    "start": "npx serve out",
    "emit:agent": "tsx scripts/emit-agent-assets.mts",
    "verify:agent": "tsx scripts/verify-agent-assets.mts",
    "analytics": "tsx scripts/analytics.mts",
    "check:docs": "tsx scripts/check-docs.mts",
    "import:guide": "tsx scripts/import-guide.mts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "^16.15.0",
    "fumadocs-mdx": "^15.3.1",
    "fumadocs-ui": "^16.15.0",
    "mermaid": "^11.17.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
