# Rayfin Docker Compose Environment Variables
#
# Copy this file to .env in your project's rayfin/.temp/ directory to customize values.
# The Rayfin CLI generates this file automatically via `rayfin dev`.
#
# IMPORTANT: Do not commit .env files containing real credentials to source control.
# This .env.example file contains safe defaults for local development only.

# ──────────────────────────────────────────────────────────────
# Database Passwords
# ──────────────────────────────────────────────────────────────
RAYFIN_POSTGRES_PASSWORD=YourStrong!Passw0rd
RAYFIN_POSTGRES_DATAAPI_PASSWORD=YourStrong!Passw0rd
RAYFIN_SQLSERVER_PASSWORD=YourStrong!Passw0rd

# ──────────────────────────────────────────────────────────────
# Service Ports (customize to avoid conflicts)
# ──────────────────────────────────────────────────────────────
RAYFIN_WEBSERVICE_HTTP_PORT=5168
RAYFIN_WEBSERVICE_HTTPS_PORT=7126
RAYFIN_POSTGRES_PORT=5432
RAYFIN_POSTGRES_DATAAPI_PORT=5433
RAYFIN_SQLSERVER_PORT=1433
RAYFIN_MAILDEV_SMTP_PORT=1025
RAYFIN_MAILDEV_WEB_PORT=1080
RAYFIN_AZURITE_BLOB_PORT=10000
RAYFIN_AZURITE_QUEUE_PORT=10001
RAYFIN_AZURITE_TABLE_PORT=10002
RAYFIN_FUNCTIONS_PORT=7071
RAYFIN_ASPIRE_UI_PORT=18888
RAYFIN_ASPIRE_OTLP_PORT=4317
